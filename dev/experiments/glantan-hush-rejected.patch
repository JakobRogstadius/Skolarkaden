diff --git a/tests/games/glantan/tactics.test.cjs b/tests/games/glantan/tactics.test.cjs
index 190af58..4597797 100644
--- a/tests/games/glantan/tactics.test.cjs
+++ b/tests/games/glantan/tactics.test.cjs
@@ -344,4 +344,51 @@ for (const type of ['sporeling', 'rattler']) {
   assert.equal(G.ownedSkeletons(w, necro).length, 1); assert.equal(G.ownedSkeletons(w, necro)[0].level, 4);
   assert.equal(healer.cooldown, 1.8); assert(!('healCooldown' in healer)); assert.equal(w.corpses.length, 0);
 }
+{
+  const { w, lair } = arena(), medic = hero(w, 'healer', 16, 15), patient = hero(w, 'warrior', 16.5, 15), husher = enemy(w, lair, 'husher', 20, 15);
+  w.time = 1; G.updateMonsters(w, .1);
+  assert.equal(patient.hushedUntil, 4, 'a real Husher hit marks the damaged hero');
+  assert(patient.hp < patient.maxHp, 'the Husher attack still deals damage');
+  patient.hp = 10; medic.hp = 10; medic.cooldown = 0; w.time = 1.1;
+  const healedBefore = patient.hp; G.updateHeroes(w, .1);
+  assert.equal(patient.hp - healedBefore, 14.25, 'the healer cast applies the 25% reduction');
+  assert(medic.healing > 0, 'healing remains a usable action while the recipient is hushed');
+  assert.equal(patient.hushedUntil, 4, 'being healed does not clear the status early');
+}
+{
+  const { w, lair } = arena(), necro = hero(w, 'necromancer', 16, 15), husher = enemy(w, lair, 'husher', 20, 15);
+  w.time = 1; G.updateMonsters(w, .1);
+  assert.equal(necro.hushedUntil, 4, 'a Husher can mark a necromancer through its real attack');
+  necro.hp = 20;
+  const victim = enemy(w, lair, 'rattler', 20, 17); victim.hp = victim.maxHp;
+  const before = necro.hp; G.necromancerStrike(w, necro, victim, 20);
+  assert.equal(necro.hp - before, 6.75, 'hush reduces the necromancer life-drain heal by 25%');
+  assert.equal(necro.hushedUntil, 4);
+}
+{
+  const { w, lair } = arena(), fighter = hero(w, 'warrior', 9, 9), husher = enemy(w, lair, 'husher', 13, 9);
+  w.time = 1; G.updateMonsters(w, .1); assert(fighter.hushedUntil > w.time);
+  husher.hp = 0;
+  const target = enemy(w, lair, 'rattler', 10.1, 9), hp = target.hp;
+  w.time = 1.2; G.updateHeroes(w, .1);
+  assert(target.hp < hp, 'a hushed warrior can still attack');
+  const before = { x: fighter.x, y: fighter.y };
+  w.time = 1.8; G.move(w, fighter, { x: 12, y: 11 }, 2, .2);
+  assert(G.distance(fighter, before) > 0, 'a hushed warrior can still move');
+}
+{
+  const { w, lair } = arena(), patient = hero(w, 'warrior'), husher = enemy(w, lair, 'husher', 20, 15);
+  patient.hp = 2; w.time = 1; G.damage(w, patient, 1, husher);
+  assert.equal(patient.hushedUntil, 4);
+  assert.equal(G.healingAmount(w, patient, 100), 75);
+  w.time = 2; G.damage(w, patient, 1, husher);
+  assert.equal(patient.hushedUntil, 5, 'a later hit refreshes the duration');
+  assert.equal(G.healingAmount(w, patient, 100), 75, 'repeated hits never stack the reduction');
+  const loaded = new G.Simulation({ saved: JSON.parse(JSON.stringify(w)) }).world;
+  assert.equal(loaded.heroes[0].hushedUntil, 5, 'save/load retains the status end time');
+  assert.equal(G.healingAmount(loaded, loaded.heroes[0], 100), 75, 'the loaded status still reduces healing');
+  loaded.time = 5;
+  assert.equal(G.healingAmount(loaded, loaded.heroes[0], 100), 100, 'healing returns to full at the three-second expiry');
+  assert.equal(G.healingAmount(loaded, { hp: 0, maxHp: 200 }, 40), 40, 'unhushed healing remains unchanged');
+}
 console.log('tactics: exclusive movement/actions, shared ability cooldowns, summons, traps, mixed waves and save migration');
